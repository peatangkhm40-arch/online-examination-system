// =============================================================================
// Database Schema — ระบบสอบออนไลน์พร้อม Anti-Cheat
// Tech Stack: PostgreSQL + Prisma
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// คำนำหน้าชื่อนักเรียน (นาย / นางสาว / นาง)
enum TitlePrefix {
  MR   // นาย
  MISS // นางสาว
  MRS  // นาง
}

// รูปแบบการออกข้อสอบ: พิมพ์เอง หรือนำไฟล์คลังข้อสอบมาวาง
enum ExamFormat {
  MANUAL      // พิมพ์ข้อสอบเอง (1 หน้าต่อ 1 ข้อ)
  IMPORT_FILE // นำไฟล์คลังข้อสอบมาวาง (.xlsx, .json)
}

// สถานะห้องสอบ: เปิดให้เข้าทำข้อสอบ หรือปิดห้องไว้ก่อน
enum RoomStatus {
  OPEN   // เปิดให้เข้ามาทำข้อสอบ
  CLOSED // ปิดห้องไว้ก่อน
}

// สถานะการทำข้อสอบของนักเรียน
enum AttemptStatus {
  IN_PROGRESS  // กำลังทำข้อสอบ
  SUBMITTED    // ส่งข้อสอบแล้ว
  DISQUALIFIED // ถูกตัดสิทธิ์จากการทุจริต
}

// ประเภทพฤติกรรมทุจริตที่ระบบดักจับได้
enum CheatEventType {
  TAB_SWITCH      // สลับแท็บเบราว์เซอร์
  APP_SWITCH      // ปัดแอป / ออกจากหน้าจอ
  WINDOW_BLUR     // หน้าต่างเสียโฟกัส
  PAGE_HIDDEN     // Page Visibility API — หน้าถูกซ่อน
  FULLSCREEN_EXIT // ออกจากโหมดเต็มจอ
  OTHER           // พฤติกรรมอื่นที่น่าสงสัย
}

/// ตารางนักเรียน — เก็บข้อมูลการลงทะเบียนและเข้าสู่ระบบ
model Student {
  id                String      @id @default(cuid())
  prefix            TitlePrefix
  firstName         String      @map("first_name")
  lastName          String      @map("last_name")
  email             String      @unique
  passwordHash      String      @map("password_hash")
  /// ระดับชั้นตอนลงทะเบียน เช่น "ปวส. 2/4" — ไม่ถูกทับเมื่อเข้าห้องเรียนด้วยรหัส
  gradeLevel        String      @map("grade_level")
  studentNumber     Int         @map("student_number")
  /// ห้องเรียนที่เข้าด้วยรหัสจากอาจารย์ (แยกจากระดับชั้นตอนสมัคร)
  joinedClassroomId String?     @map("joined_classroom_id")
  isActive          Boolean     @default(true) @map("is_active")
  /// แอดมินยืนยันแล้วว่าเป็นนักเรียนวิทยาลัยจริง
  isCollegeVerified Boolean     @default(false) @map("is_college_verified")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  joinedClassroom TeacherClassroom? @relation(fields: [joinedClassroomId], references: [id], onDelete: SetNull)
  cheatLogs       CheatLog[]
  attempts        ExamAttempt[]

  // เลขที่ต้องไม่ซ้ำภายในระดับชั้นเดียวกัน
  @@unique([gradeLevel, studentNumber])
  @@map("students")
}

/// ตารางแอดมิน — สร้างบัญชีอาจารย์และดูแลระบบ
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

/// ตารางอาจารย์ — บัญชีที่ Admin สร้างไว้ล่วงหน้าเพื่อเข้าใช้งานระบบ
model Teacher {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  examRooms   ExamRoom[]
  subjects    TeacherSubject[]
  classrooms  TeacherClassroom[]

  @@map("teachers")
}

/// ตารางห้องเรียนที่อาจารย์ดูแล — แยกจากการสร้างห้องสอบ
model TeacherClassroom {
  id        String   @id @default(cuid())
  teacherId String   @map("teacher_id")
  /// ชื่อห้องเรียน เช่น "ปวส. 2/4"
  name      String
  /// รหัสเข้าห้องเรียนที่แจกให้นักเรียน เช่น CLASS2A4F
  joinCode  String   @unique @map("join_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teacher   Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  students  Student[]
  examRooms ExamRoom[]

  @@unique([teacherId, name])
  @@map("teacher_classrooms")
}

/// ตารางวิชาที่อาจารย์แต่ละคนสอน — ใช้เป็นตัวเลือกตอนสร้างห้องสอบ
model TeacherSubject {
  id        String   @id @default(cuid())
  teacherId String   @map("teacher_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  // วิชาต้องไม่ซ้ำภายในอาจารย์คนเดียวกัน
  @@unique([teacherId, name])
  @@map("teacher_subjects")
}

/// ตารางห้องสอบ — รหัสเข้าห้อง (Class Code), วิชา, รูปแบบข้อสอบ, สถานะห้อง
model ExamRoom {
  id          String     @id @default(cuid())
  classCode   String     @unique @map("class_code") // รหัสสุ่ม เช่น ROOM99
  subjectName String     @map("subject_name")
  /// ห้องเรียน/ระดับชั้นที่ห้องสอบนี้เปิดให้ เช่น "ปวส. 2/4" (null = เปิดให้ทุกห้อง)
  gradeLevel  String?    @map("target_grade_level")
  /// อ้างอิงห้องเรียนที่เลือกตอนสร้างห้องสอบ (ถ้ามี)
  classroomId String?    @map("classroom_id")
  examFormat  ExamFormat @map("exam_format")
  roomStatus  RoomStatus @default(CLOSED) @map("room_status")
  /// ลิงก์หรือ path ของไฟล์คลังข้อสอบ (ใช้เมื่อ examFormat = IMPORT_FILE)
  examSource  String?    @map("exam_source")
  teacherId   String     @map("teacher_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  teacher   Teacher            @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  classroom TeacherClassroom?  @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  cheatLogs CheatLog[]
  questions Question[]
  attempts  ExamAttempt[]

  @@map("exam_rooms")
}

/// ตารางคำถามในห้องสอบ — ตัวเลือกแบบปรนัย
model Question {
  id           String   @id @default(cuid())
  examRoomId   String   @map("exam_room_id")
  questionText String   @map("question_text")
  points       Int      @default(1)
  orderIndex   Int      @default(0) @map("order_index")
  createdAt    DateTime @default(now()) @map("created_at")

  examRoom ExamRoom         @relation(fields: [examRoomId], references: [id], onDelete: Cascade)
  options  QuestionOption[]
  answers  AttemptAnswer[]

  @@index([examRoomId, orderIndex])
  @@map("questions")
}

/// ตัวเลือกของแต่ละคำถาม (ก ข ค ง)
model QuestionOption {
  id         String  @id @default(cuid())
  questionId String  @map("question_id")
  optionText String  @map("option_text")
  isCorrect  Boolean @default(false) @map("is_correct")
  orderIndex Int     @default(0) @map("order_index")

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  @@index([questionId])
  @@map("question_options")
}

/// ตารางการทำข้อสอบ — บันทึกคะแนนเพื่อรายงานและการเก็บคะแนน
model ExamAttempt {
  id          String        @id @default(cuid())
  studentId   String        @map("student_id")
  examRoomId  String        @map("exam_room_id")
  status      AttemptStatus @default(IN_PROGRESS)
  /// คะแนนที่ได้ (คิดตอน submit)
  score       Int?
  /// คะแนนเต็มของชุดข้อสอบ ณ ตอนทำ
  maxScore    Int?          @map("max_score")
  startedAt   DateTime      @default(now()) @map("started_at")
  submittedAt DateTime?     @map("submitted_at")

  student  Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examRoom ExamRoom        @relation(fields: [examRoomId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  // นักเรียน 1 คนทำข้อสอบห้องเดียวกันได้ครั้งเดียว
  @@unique([studentId, examRoomId])
  @@index([examRoomId, status])
  @@map("exam_attempts")
}

/// คำตอบรายข้อของนักเรียน
model AttemptAnswer {
  id               String   @id @default(cuid())
  attemptId        String   @map("attempt_id")
  questionId       String   @map("question_id")
  selectedOptionId String   @map("selected_option_id")
  answeredAt       DateTime @default(now()) @map("answered_at")

  attempt        ExamAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuestionOption @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  // 1 ข้อตอบได้คำตอบเดียว (บันทึกทับเมื่อเปลี่ยนคำตอบ)
  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}

/// ตารางบันทึกการทุจริต — ส่งแจ้งเตือนไปยังฝั่งอาจารย์แบบเรียลไทม์
model CheatLog {
  id          String         @id @default(cuid())
  studentId   String         @map("student_id")
  examRoomId  String         @map("exam_room_id")
  eventType   CheatEventType @map("event_type")
  /// รายละเอียดพฤติกรรม เช่น "นักเรียนสลับแท็บออกจากหน้าข้อสอบ"
  description String?
  /// ข้อมูลเพิ่มเติมจาก Frontend (userAgent, timestamp ฯลฯ)
  metadata    Json?
  /// อาจารย์ได้รับแจ้งเตือนแล้วหรือยัง
  isNotified  Boolean        @default(false) @map("is_notified")
  createdAt   DateTime       @default(now()) @map("created_at")

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examRoom ExamRoom @relation(fields: [examRoomId], references: [id], onDelete: Cascade)

  @@index([examRoomId, createdAt])
  @@index([studentId, examRoomId])
  @@map("cheat_logs")
}
